# Fireworks AI 自动注册工具 - 环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================
# Primary 邮箱服务配置（可选）
# ============================================
# 默认已配置 chatgpt.org.uk 服务
# 如需使用其他服务，取消注释并修改：
# PRIMARY_EMAIL_URL=https://your-email-service.com
# PRIMARY_EMAIL_API_KEY=your_api_key

# ============================================
# 浏览器配置（可选）
# ============================================
# BROWSER_HEADLESS=true
# BROWSER_WINDOW_SIZE=1920,1080
